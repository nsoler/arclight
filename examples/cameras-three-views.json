{
  "project": { "folder": ".", "format": { "width": 960, "height": 540 },
               "fps": 24.0, "first_frame": 1, "last_frame": 48 },
  "nodes": [
    { "id": "ground", "op": "plane",
      "params": { "size": [30, 30], "rotate": [-90, 0, 0], "color": [0.45, 0.42, 0.38, 1] },
      "pos": [40, 60] },
    { "id": "block", "op": "cube",
      "params": { "size": [2, 2, 2], "translate": [-2.2, 1, 0.5], "rotate": [0, 25, 0], "color": [0.85, 0.45, 0.2, 1] },
      "pos": [40, 140] },
    { "id": "ball", "op": "sphere",
      "params": { "radius": 1.0, "translate": [1.2, 1, 1.5], "color": [0.2, 0.55, 0.8, 1], "shading": "blinn", "specular": 0.4, "roughness": 0.3 },
      "pos": [40, 220] },
    { "id": "pillar", "op": "cylinder",
      "params": { "radius": 0.5, "height": 3.5, "translate": [2.6, 1.75, -2], "color": [0.8, 0.8, 0.75, 1] },
      "pos": [40, 300] },
    { "id": "props", "op": "scene", "inputs": ["ground", "block", "ball", "pillar"],
      "pos": [230, 180] },

    { "id": "sun", "op": "light_directional",
      "params": { "rotate": [-50, 35, 0], "intensity": 1.0, "shadows": true, "shadow_softness": 2.0 },
      "pos": [40, 420] },
    { "id": "fill", "op": "light_ambient", "params": { "intensity": 0.3 },
      "pos": [40, 500] },
    { "id": "lights", "op": "scene", "inputs": ["sun", "fill", "", ""],
      "pos": [230, 460] },

    { "id": "cam_wide", "op": "camera",
      "params": { "focal": 24,
                  "translate": { "keys": [[1, [-2.5, 4, 8]], [48, [2.5, 4, 8]]], "interp": "smooth" },
                  "rotate": { "keys": [[1, [-22, -14, 0]], [48, [-22, 14, 0]]], "interp": "smooth" } },
      "pos": [40, 620] },
    { "id": "cam_close", "op": "camera",
      "params": { "focal": 40, "translate": [3, 1.6, 6.5], "rotate": [-6, 20, 0] },
      "pos": [40, 700] },
    { "id": "cam_top", "op": "camera",
      "params": { "projection": "orthographic", "ortho_width": 14, "translate": [0, 15, 0], "rotate": [-90, 0, 0] },
      "pos": [40, 780] },
    { "id": "cameras", "op": "scene", "inputs": ["cam_wide", "cam_close", "cam_top", ""],
      "pos": [230, 700] },

    { "id": "world", "op": "scene", "inputs": ["props", "lights", "cameras", ""],
      "pos": [420, 460] },
    { "id": "sky", "op": "constant",
      "params": { "width": 960, "height": 540, "color": [0.55, 0.68, 0.85, 1] },
      "pos": [420, 560] },

    { "id": "render_wide", "op": "scanline_render", "inputs": ["world", "", "sky"],
      "params": { "camera": "cam_wide", "width": 960, "height": 540, "samples": 2 },
      "pos": [610, 340] },
    { "id": "render_close", "op": "scanline_render", "inputs": ["world", "", "sky"],
      "params": { "camera": "cam_close", "width": 960, "height": 540, "samples": 2 },
      "pos": [610, 460] },
    { "id": "render_top", "op": "scanline_render", "inputs": ["world", "", "sky"],
      "params": { "camera": "cam_top", "width": 960, "height": 540, "samples": 2 },
      "pos": [610, 580] },
    { "id": "viewer_wide", "op": "viewer", "inputs": ["render_wide"], "pos": [800, 300] },
    { "id": "viewer_close", "op": "viewer", "inputs": ["render_close"], "pos": [800, 420] },
    { "id": "viewer_top", "op": "viewer", "inputs": ["render_top"], "pos": [800, 540] },

    { "id": "sheet_bg", "op": "constant",
      "params": { "width": 960, "height": 540, "color": [0.05, 0.05, 0.06, 1] },
      "pos": [990, 200] },
    { "id": "place_wide", "op": "transform", "inputs": ["render_wide"],
      "params": { "scale": [0.48, 0.48], "translate": [-240, -135] },
      "pos": [990, 300] },
    { "id": "place_close", "op": "transform", "inputs": ["render_close"],
      "params": { "scale": [0.48, 0.48], "translate": [240, -135] },
      "pos": [990, 420] },
    { "id": "place_top", "op": "transform", "inputs": ["render_top"],
      "params": { "scale": [0.48, 0.48], "translate": [-240, 135] },
      "pos": [990, 540] },
    { "id": "sheet_wide", "op": "merge", "inputs": ["place_wide", "sheet_bg"],
      "pos": [1180, 300] },
    { "id": "sheet_close", "op": "merge", "inputs": ["place_close", "sheet_wide"],
      "pos": [1180, 420] },
    { "id": "sheet", "op": "merge", "inputs": ["place_top", "sheet_close"],
      "pos": [1180, 540] },
    { "id": "viewer", "op": "viewer", "inputs": ["sheet"], "pos": [1370, 540] }
  ],
  "backdrops": [
    { "id": "bd_set", "title": "One set: ground, block, ball, pillar, a sun casting shadows and a soft fill", "pos": [20, 20], "size": [380, 530], "color": [0.2, 0.3, 0.35] },
    { "id": "bd_cams", "title": "Three cameras: wide (animated, a slow dolly across), close-up (85 mm on the ball), top (orthographic, a plan view)", "pos": [20, 590], "size": [380, 240], "color": [0.3, 0.25, 0.35] },
    { "id": "bd_world", "title": "ONE Scene holds the set, the lights and every camera", "pos": [400, 420], "size": [190, 200], "color": [0.25, 0.3, 0.25] },
    { "id": "bd_renders", "title": "Three Scanline Renders of that one Scene, nothing on their camera inputs: each one's Camera param names its camera (cam_wide, cam_close, cam_top). Switching a render's view is one field, not rewiring; renaming a camera keeps its render on it", "pos": [590, 260], "size": [380, 380], "color": [0.25, 0.35, 0.25] },
    { "id": "bd_sheet", "title": "Contact sheet in the main Viewer: Transform scales each view by about half into a cell of a 2 × 2 grid, Merges stack them (the fourth cell is free for a fourth camera); a Viewer per view beside the renders", "pos": [970, 150], "size": [560, 490], "color": [0.35, 0.3, 0.2] }
  ]
}
